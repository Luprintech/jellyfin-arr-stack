# Copia este archivo a .env y ajusta los valores:  cp .env.example .env
# El archivo .env NO se sube a git (está en .gitignore).

# --- Usuario y zona horaria -------------------------------------------------
# Usuario dueño de tus carpetas de medios. Averígualo con:  id tu_usuario
PUID=1000
PGID=1000
TZ=Europe/Madrid

# --- Rutas ------------------------------------------------------------------
# Donde se guardan las configuraciones de cada app (una subcarpeta por app).
CONFIG_ROOT=/srv/media-stack/config

# Carpeta ÚNICA con descargas y bibliotecas. Tiene que ser UNA sola carpeta
# (un solo sistema de archivos) para que funcionen los hardlinks.
DATA_ROOT=/srv/media

# --- Jellyfin: aceleración por hardware (opcional) ---------------------------
# GID del grupo dueño de /dev/dri/renderD128. Averígualo con:
#   stat -c '%g' /dev/dri/renderD128
# En Synology suele ser el grupo "videodriver" (p. ej. 937).
RENDER_GID=44

# --- Puertos (cámbialos solo si chocan con algo) ----------------------------
JELLYFIN_PORT=8096
QBIT_WEBUI_PORT=8085
QBIT_TORRENT_PORT=51413
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
SEERR_PORT=5055
WIZARR_PORT=5690
CHAPTARR_PORT=8789

# --- Wizarr -----------------------------------------------------------------
# Dirección pública con la que compartirás las invitaciones (o la IP local).
WIZARR_APP_URL=http://192.168.1.10:5690

# --- Chaptarr (libros y audiolibros) ----------------------------------------
# Pon una contraseña larga y aleatoria. Genera una con:  openssl rand -hex 24
CHAPTARR_DB_PASSWORD=cambia-esto-por-una-contraseña-larga
